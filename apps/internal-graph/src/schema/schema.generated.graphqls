input AddItemToCartInput {
  count: Int!
  productId: ID!
}

type Cart {
  id: ID!
  items: [CartItem!]!
}

type CartItem {
  count: Int!
  productId: ID!
}

type Mutation {
  addItemToCart(input: AddItemToCartInput!): Cart
  rateProduct(input: RateProductInput!): ProductRating
}

input PaginationInput {
  page: Int
  pageSize: Int
}

type PaginationResult {
  page: Int!
  pageSize: Int!
  total: Int!
  totalPages: Int!
}

type Product {
  category: String!
  description: String!
  id: ID!
  imageUrl: String!
  name: String!
  price: Float!
  reviewCount: Int!
  stockCount: Int!
}

type ProductRating {
  id: ID!
  value: Float!
}

type ProductReviewCount {
  id: ID!
  value: Int!
}

input ProductsInput {
  category: String
  inStock: Boolean
  maxPrice: Int
  minPrice: Int
  searchTerm: String
}

type ProductsResponse {
  pagination: PaginationResult!
  result: [Product!]!
}

type Query {
  cart(id: ID!): Cart
  product(id: ID!): Product
  productRating(id: ID!): ProductRating!
  products(input: ProductsInput!, pagination: PaginationInput!): ProductsResponse!
}

input RateProductInput {
  id: ID!
  rating: Int!
}

type ResponseError {
  type: ResponseErrorType!
}

enum ResponseErrorType {
  SERVER_ERROR
}