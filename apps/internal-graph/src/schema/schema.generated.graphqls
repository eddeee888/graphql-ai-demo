input AddItemToCartInput {
  count: Int!
  productId: ID!
  userId: ID!
}

type AddItemToCartResponse {
  result: Cart!
}

type Cart {
  """Each user only has one cart, so the Cart ID is the User's ID"""
  id: ID!
  items: [CartItem!]!
}

type CartItem {
  count: Int!
  productId: ID!
}

type CartResponse {
  result: Cart!
}

input ClearCartInput {
  userId: ID!
}

type ClearCartResponse {
  result: Cart!
}

scalar DateTime

type Mutation {
  """Mutation to add a product to a user's cart"""
  addItemToCart(input: AddItemToCartInput!): AddItemToCartResponse!

  """Mutation to clear a user's cart"""
  clearCart(input: ClearCartInput!): ClearCartResponse!

  """Mutation.rateProduct rates a product as the userId in the input"""
  rateProduct(input: RateProductInput!): RateProductResponse!
}

"""Standard pagination input"""
input PaginationInput {
  page: Int
  pageSize: Int
}

"""Standard pagination result"""
type PaginationResult {
  page: Int!
  pageSize: Int!
  total: Int!
  totalPages: Int!
}

type Product {
  category: String!
  description: String!
  id: ID!
  imageUrl: String!
  name: String!
  price: Float!
  reviewCount: Int!
  stockCount: Int!
}

input ProductListFilterInput {
  categories: [String!]
  inStock: Boolean
  maxPrice: Int
  minPrice: Int
  searchTerm: String
}

type ProductListResponse {
  pagination: PaginationResult!
  result: [Product!]!
}

type ProductRating {
  """When the rating was created"""
  createdAt: DateTime!

  """The effective person who made this rating"""
  creatorUserId: ID!

  """ProductRating's UUID"""
  id: ID!

  """The product that the rating was rated for"""
  productId: ID!

  """The value of the rating"""
  rating: Int!
}

type ProductRatingByProductIdsResponse {
  result: [Product_Rating!]!
}

input ProductRatingsFilterInput {
  from: DateTime!
  to: DateTime!
}

type ProductRatingsResponse {
  pagination: PaginationResult!
  ratings: [ProductRating!]!
}

"""Product_Rating is an extension of Product entity"""
type Product_Rating {
  average: Float!

  """Product_Rating's ID is Product's ID"""
  id: ID!
}

type ProductsByIdsResponse {
  result: [Product]!
}

type Query {
  """
  Query.cart
  Gets a user's cart by the user's ID
  Note that each user can only have one cart
  """
  cart(id: ID!): CartResponse!

  """
  Query.productList is more expensive to run compared to Query.productsByIds
  This is because it does a scan across all items in the database
  If the request has product IDs, Query.productsByIds instead
  """
  productList(filter: ProductListFilterInput!, pagination: PaginationInput!): ProductListResponse!

  """Query.productRatingByProductIds gets ratings of provided product IDs"""
  productRatingByProductIds(ids: [ID!]!): ProductRatingByProductIdsResponse!

  """Query.productRatings gets paginated list of ProductRating"""
  productRatings(filter: ProductRatingsFilterInput!, pagination: PaginationInput!): ProductRatingsResponse!

  """
  Query.productsByIds should be used if a list of IDs is known
  e.g. if the UI takes in an product ID to display
  """
  productsByIds(ids: [ID!]!): ProductsByIdsResponse!
}

input RateProductInput {
  productId: ID!
  rating: Int!
  userId: ID!
}

type RateProductResponse {
  result: Product_Rating!
}