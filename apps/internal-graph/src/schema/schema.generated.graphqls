input AddItemToCartInput {
  count: Int!
  productId: ID!
  userId: ID!
}

type AddItemToCartResponse {
  result: Cart!
}

type Cart {
  id: ID!
  items: [CartItem!]!
}

type CartItem {
  count: Int!
  productId: ID!
}

type CartResponse {
  result: Cart!
}

input ClearCartInput {
  userId: ID!
}

type ClearCartResponse {
  result: Cart!
}

type Mutation {
  addItemToCart(input: AddItemToCartInput!): AddItemToCartResponse!
  clearCart(input: ClearCartInput!): ClearCartResponse!
  rateProduct(input: RateProductInput!): RateProductResponse!
}

input PaginationInput {
  page: Int
  pageSize: Int
}

type PaginationResult {
  page: Int!
  pageSize: Int!
  total: Int!
  totalPages: Int!
}

type Product {
  category: String!
  description: String!
  id: ID!
  imageUrl: String!
  name: String!
  price: Float!
  reviewCount: Int!
  stockCount: Int!
}

input ProductListFilterInput {
  categories: [String!]
  inStock: Boolean
  maxPrice: Int
  minPrice: Int
  searchTerm: String
}

type ProductListResponse {
  pagination: PaginationResult!
  result: [Product!]!
}

type ProductRating {
  id: ID!
  value: Float!
}

type ProductRatingByProductIdsResponse {
  result: [ProductRating!]!
}

type ProductReviewCount {
  id: ID!
  value: Int!
}

type ProductsByIdsResponse {
  result: [Product]!
}

type Query {
  cart(id: ID!): CartResponse!
  productList(filter: ProductListFilterInput!, pagination: PaginationInput!): ProductListResponse!
  productRatingByProductIds(ids: [ID!]!): ProductRatingByProductIdsResponse!
  productsByIds(ids: [ID!]!): ProductsByIdsResponse!
}

input RateProductInput {
  productId: ID!
  rating: Int!
  userId: ID!
}

type RateProductResponse {
  result: ProductRating!
}