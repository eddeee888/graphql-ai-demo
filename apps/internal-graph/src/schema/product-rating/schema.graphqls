extend type Query {
  """
  Query.productRatingByProductIds gets ratings of provided product IDs
  """
  productRatingByProductIds(ids: [ID!]!): ProductRatingByProductIdsResponse!
}

extend type Mutation {
  """
  Mutation.rateProduct rates a product as the userId in the input
  """
  rateProduct(input: RateProductInput!): RateProductResponse!
}

type ProductRatingByProductIdsResponse {
  result: [Product_Rating!]!
}

input RateProductInput {
  userId: ID!
  productId: ID!
  rating: Int!
}

type RateProductResponse {
  result: Product_Rating!
}

"""
Product_Rating is an extension of Product entity
"""
type Product_Rating {
  """
  Product_Rating's ID is Product's ID
  """
  id: ID!
  average: Float!
}
