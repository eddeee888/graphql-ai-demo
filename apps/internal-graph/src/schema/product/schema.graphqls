extend type Query {
  productsByIds(ids: [ID!]!): ProductsByIdsResponse!
  productList(
    filter: ProductListFilterInput!
    pagination: PaginationInput!
  ): ProductListResponse!
}

type ProductsByIdsResponse {
  result: [Product]!
}

type ProductListResponse {
  result: [Product!]!
  pagination: PaginationResult!
}

input ProductListFilterInput {
  categories: [String!]
  minPrice: Int
  maxPrice: Int
  inStock: Boolean
  searchTerm: String
}

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: String!
  imageUrl: String!
  stockCount: Int!
  reviewCount: Int!
}
