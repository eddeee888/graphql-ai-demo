extend type Query {
  product(id: ID!): ProductResponse!
  products(
    input: ProductsInput!
    pagination: PaginationInput!
  ): ProductsResponse!
}

extend type Mutation {
  rateProduct(input: RateProductInput!): RateProductResponse!
}

union ProductResponse = ProductResponseSuccess | ResponseError
union ProductsResponse = ProductsResponseSuccess | ResponseError
union RateProductResponse = RateProductResponseSuccess | ResponseError

type ProductResponseSuccess {
  result: Product
}

input ProductsInput {
  category: String
  minPrice: Int
  maxPrice: Int
  inStock: Boolean
  searchTerm: String
}

type ProductsResponseSuccess {
  result: [Product!]!
  total: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

input RateProductInput {
  id: ID!
  rating: Int!
}

type RateProductResponseSuccess {
  result: ProductRating!
}

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: String!
  imageUrl: String!
  inStock: Boolean!
  rating: ProductRatingResponse!
  reviewCount: Int!
}

union ProductRatingResponse = ProductRatingResponseSuccess | ResponseError

type ProductRatingResponseSuccess {
  result: ProductRating!
}

type ProductRating {
  id: ID!
  value: Float!
}
