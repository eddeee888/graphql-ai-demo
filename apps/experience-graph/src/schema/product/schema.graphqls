extend type Query {
  product(id: ID!): ProductResponse!
}

union ProductResponse = ProductResponseSuccess | ResponseError

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: String!
  imageUrl: String!
  inStock: Boolean!
  rating: Float!
  reviewCount: Int!
}

type ProductResponseSuccess {
  result: Product
}
