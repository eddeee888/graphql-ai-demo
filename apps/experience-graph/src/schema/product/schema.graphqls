extend type Query {
  product(id: ID!): ProductResponse!
  products(input: ProductsInput!): ProductsResponse!
}

union ProductResponse = ProductResponseSuccess | ResponseError
union ProductsResponse = ProductsResponseSuccess | ResponseError

type ProductResponseSuccess {
  result: Product
}

input ProductsInput {
  category: String
  minPrice: Int
  maxPrice: Int
  inStock: Boolean
  searchTerm: String
  page: Int
  pageSize: Int
}

type ProductsResponseSuccess {
  result: [Product!]!
  total: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

type Product {
  id: ID!
  name: String!
  description: String!
  price: Float!
  category: String!
  imageUrl: String!
  inStock: Boolean!
  rating: Float!
  reviewCount: Int!
}

type ProductCategory {
  id: ID!
}
