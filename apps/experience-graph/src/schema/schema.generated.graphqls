input AddItemToCartInput {
  count: Int
  productId: ID!
}

union AddItemToCartResponse = AddItemToCartResponseSuccess | ResponseError

type AddItemToCartResponseSuccess {
  result: Cart!
}

type AgentChat {
  id: ID!
  messages: [ChatMessage!]!
}

union AgentChatResponse = AgentChatResponseSuccess | ResponseError

type AgentChatResponseSuccess {
  result: AgentChat!
}

union AgentChatUpdate = AgentEventRunCompleted | AgentEventTextDelta | ChatMessage

type AgentEventRunCompleted {
  seq: Int!
}

type AgentEventTextDelta {
  seq: Int!
  text: String!
}

type Cart {
  id: ID!
  items: [CartItem!]!
}

type CartItem {
  count: Int!
  product: CartItemProductResponse!
}

union CartItemProductResponse = CartItemProductResponseSuccess | ResponseError

type CartItemProductResponseSuccess {
  result: Product!
}

union CartResponse = CartResponseSuccess | ResponseError

type CartResponseSuccess {
  result: Cart!
}

type CartUpdatesResponseSuccess {
  update: String!
}

type ChatMessage {
  content: String!
  createdAt: DateTime!
  id: ID!
  isMe: Boolean!
}

union ClearCartResponse = ClearCartResponseSuccess | ResponseError

type ClearCartResponseSuccess {
  result: Cart!
}

scalar DateTime

type Mutation {
  addItemToCart(input: AddItemToCartInput!): AddItemToCartResponse!
  clearCart: ClearCartResponse!
  rateProduct(input: RateProductInput!): RateProductResponse!
  sendAgentChatMessage(input: SendAgentChatMessageInput!): SendAgentChatMessageResponse!
}

type Pagination {
  page: Int!
  pageSize: Int!
  total: Int!
  totalPages: Int!
}

input PaginationInput {
  page: Int
  pageSize: Int
}

type Product {
  category: String!
  description: String!
  id: ID!
  imageUrl: String!
  inStock: Boolean!
  name: String!
  price: Float!
  rating: ProductRatingResponse!
  reviewCount: Int!
}

type ProductRating {
  id: ID!
  value: Float!
}

union ProductRatingResponse = ProductRatingResponseSuccess | ResponseError

type ProductRatingResponseSuccess {
  result: ProductRating!
}

union ProductResponse = ProductResponseSuccess | ResponseError

type ProductResponseSuccess {
  result: Product
}

input ProductsInput {
  categories: [String!]
  inStock: Boolean
  maxPrice: Int
  minPrice: Int
  searchTerm: String
}

union ProductsResponse = ProductsResponseSuccess | ResponseError

type ProductsResponseSuccess {
  pagination: Pagination!
  result: [Product!]!
}

type Query {
  agentChat: AgentChatResponse!
  cart: CartResponse!
  product(id: ID!): ProductResponse!
  products(input: ProductsInput!, pagination: PaginationInput!): ProductsResponse!
}

input RateProductInput {
  id: ID!
  rating: Int!
}

union RateProductResponse = RateProductResponseSuccess | ResponseError

type RateProductResponseSuccess {
  result: ProductRating!
}

type ResponseError {
  type: ResponseErrorType!
}

enum ResponseErrorType {
  SERVER_ERROR
  UNAUTHENTICATED
}

input SendAgentChatMessageInput {
  content: String!
  messageId: ID!
}

union SendAgentChatMessageResponse = ResponseError | SendAgentChatMessageResponseSuccess

type SendAgentChatMessageResponseSuccess {
  result: ChatMessage!
}

type Subscription {
  agentChatUpdates: AgentChatUpdate!
  cartUpdates: CartUpdatesResponseSuccess!
}