type Mutation

type Product {
  category: String!
  description: String!
  id: ID!
  imageUrl: String!
  inStock: Boolean!
  name: String!
  price: Float!
  rating: Int!
  reviewCount: Int!
}

union ProductResponse = ProductResponseSuccess | ResponseError

type ProductResponseSuccess {
  result: Product
}

type Query {
  product(id: ID!): ProductResponse!
}

type ResponseError {
  type: ResponseErrorType!
}

enum ResponseErrorType {
  SERVER_ERROR
}