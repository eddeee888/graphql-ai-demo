type Query
type Mutation
type Subscription

type ResponseError {
  type: ResponseErrorType!
}

enum ResponseErrorType {
  UNAUTHENTICATED
  SERVER_ERROR
}

input PaginationInput {
  page: Int
  pageSize: Int
}

type Pagination {
  total: Int!
  page: Int!
  pageSize: Int!
  totalPages: Int!
}

scalar DateTime
